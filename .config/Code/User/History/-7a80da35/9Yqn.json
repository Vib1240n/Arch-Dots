// AstroNvim-style keybindings for VS Code
// Maps AstroNvim's <Leader> (Space) commands to VS Code native commands
// Active only in normal mode when vscode-neovim is loaded
// Place at: ~/.config/Code/User/keybindings.json
[
  // ═══════════════════════════════════════════════════════════════
  // FIND / TELESCOPE EQUIVALENTS (Leader f...)
  // ═══════════════════════════════════════════════════════════════
  {
    "key": "space f f",
    "command": "workbench.action.quickOpen",
    "when": "neovim.mode == 'normal' && editorTextFocus"
  },
    {
  "key": "g g",
  "command": "cursorTop",
  "when": "neovim.mode == 'normal' && editorTextFocus"
},
  {
    "key": "space f f",
    "command": "workbench.action.quickOpen",
    "when": "neovim.mode == 'normal' && !editorTextFocus"
  },
  {
    "key": "space f b",
    "command": "workbench.action.showAllEditors",
    "when": "neovim.mode == 'normal'"
  },
  {
    "key": "space f w",
    "command": "workbench.action.findInFiles",
    "when": "neovim.mode == 'normal'"
  },
  {
    "key": "space f c",
    "command": "workbench.action.findInFiles",
    "args": {
      "query": ""
    },
    "when": "neovim.mode == 'normal'"
  },
  {
    "key": "space f h",
    "command": "workbench.action.openRecent",
    "when": "neovim.mode == 'normal'"
  },
  {
    "key": "space f o",
    "command": "workbench.action.openRecent",
    "when": "neovim.mode == 'normal'"
  },
  {
    "key": "space f /",
    "command": "actions.find",
    "when": "neovim.mode == 'normal' && editorTextFocus"
  },
  {
    "key": "space f m",
    "command": "editor.action.formatDocument",
    "when": "neovim.mode == 'normal' && editorTextFocus"
  },
  {
    "key": "space f n",
    "command": "explorer.newFile",
    "when": "neovim.mode == 'normal'"
  },
  {
    "key": "space f s",
    "command": "workbench.action.gotoSymbol",
    "when": "neovim.mode == 'normal' && editorTextFocus"
  },
  {
    "key": "space f S",
    "command": "workbench.action.showAllSymbols",
    "when": "neovim.mode == 'normal'"
  },
  {
    "key": "space f t",
    "command": "workbench.action.selectTheme",
    "when": "neovim.mode == 'normal'"
  },
  {
    "key": "space f k",
    "command": "workbench.action.openGlobalKeybindings",
    "when": "neovim.mode == 'normal'"
  },
  {
    "key": "space f '",
    "command": "workbench.action.tasks.runTask",
    "when": "neovim.mode == 'normal'"
  },
  // ═══════════════════════════════════════════════════════════════
  // BUFFER MANAGEMENT (Leader b...)
  // ═══════════════════════════════════════════════════════════════
  {
    "key": "space b d",
    "command": "workbench.action.closeActiveEditor",
    "when": "neovim.mode == 'normal'"
  },
  {
    "key": "space b c",
    "command": "workbench.action.closeOtherEditors",
    "when": "neovim.mode == 'normal'"
  },
  {
    "key": "space b C",
    "command": "workbench.action.closeAllEditors",
    "when": "neovim.mode == 'normal'"
  },
  {
    "key": "space b l",
    "command": "workbench.action.closeEditorsToTheRight",
    "when": "neovim.mode == 'normal'"
  },
  {
    "key": "space b h",
    "command": "workbench.action.closeEditorsToTheLeft",
    "when": "neovim.mode == 'normal'"
  },
  {
    "key": "space b s",
    "command": "workbench.action.files.save",
    "when": "neovim.mode == 'normal'"
  },
  {
    "key": "space b n",
    "command": "workbench.action.nextEditorInGroup",
    "when": "neovim.mode == 'normal'"
  },
  {
    "key": "space b p",
    "command": "workbench.action.previousEditorInGroup",
    "when": "neovim.mode == 'normal'"
  },
  // ═══════════════════════════════════════════════════════════════
  // BUFFER NAVIGATION (]b and [b)
  // ═══════════════════════════════════════════════════════════════
  {
    "key": "] b",
    "command": "workbench.action.nextEditor",
    "when": "neovim.mode == 'normal'"
  },
  {
    "key": "[ b",
    "command": "workbench.action.previousEditor",
    "when": "neovim.mode == 'normal'"
  },
  // ═══════════════════════════════════════════════════════════════
  // FILE EXPLORER (Leader e / E)
  // ═══════════════════════════════════════════════════════════════
  {
    "key": "space e",
    "command": "workbench.view.explorer",
    "when": "neovim.mode == 'normal' && !explorerViewletVisible"
  },
  {
    "key": "space e",
    "command": "workbench.action.toggleSidebarVisibility",
    "when": "neovim.mode == 'normal' && explorerViewletVisible"
  },
  {
    "key": "space E",
    "command": "workbench.view.explorer",
    "when": "neovim.mode == 'normal'"
  },
  {
    "key": "space o",
    "command": "workbench.action.focusActiveEditorGroup",
    "when": "neovim.mode == 'normal'"
  },
  // ═══════════════════════════════════════════════════════════════
  // LSP / CODE ACTIONS (Leader l...)
  // ═══════════════════════════════════════════════════════════════
  {
    "key": "space l a",
    "command": "editor.action.codeAction",
    "when": "neovim.mode == 'normal' && editorTextFocus"
  },
  {
    "key": "space l f",
    "command": "editor.action.formatDocument",
    "when": "neovim.mode == 'normal' && editorTextFocus"
  },
  {
    "key": "space l r",
    "command": "editor.action.rename",
    "when": "neovim.mode == 'normal' && editorTextFocus"
  },
  {
    "key": "space l h",
    "command": "editor.action.showHover",
    "when": "neovim.mode == 'normal' && editorTextFocus"
  },
  {
    "key": "space l d",
    "command": "editor.action.revealDefinition",
    "when": "neovim.mode == 'normal' && editorTextFocus"
  },
  {
    "key": "space l D",
    "command": "editor.action.revealDeclaration",
    "when": "neovim.mode == 'normal' && editorTextFocus"
  },
  {
    "key": "space l i",
    "command": "editor.action.goToImplementation",
    "when": "neovim.mode == 'normal' && editorTextFocus"
  },
  {
    "key": "space l t",
    "command": "editor.action.goToTypeDefinition",
    "when": "neovim.mode == 'normal' && editorTextFocus"
  },
  {
    "key": "space l R",
    "command": "editor.action.goToReferences",
    "when": "neovim.mode == 'normal' && editorTextFocus"
  },
  {
    "key": "space l s",
    "command": "workbench.action.gotoSymbol",
    "when": "neovim.mode == 'normal' && editorTextFocus"
  },
  {
    "key": "space l S",
    "command": "workbench.action.showAllSymbols",
    "when": "neovim.mode == 'normal'"
  },
  {
    "key": "space l G",
    "command": "workbench.action.showAllSymbols",
    "when": "neovim.mode == 'normal'"
  },
  // gd / gD / gI / gr (vim-native bindings to LSP)
  {
    "key": "g d",
    "command": "editor.action.revealDefinition",
    "when": "neovim.mode == 'normal' && editorTextFocus"
  },
  {
    "key": "g D",
    "command": "editor.action.revealDeclaration",
    "when": "neovim.mode == 'normal' && editorTextFocus"
  },
  {
    "key": "g I",
    "command": "editor.action.goToImplementation",
    "when": "neovim.mode == 'normal' && editorTextFocus"
  },
  {
    "key": "g r",
    "command": "editor.action.goToReferences",
    "when": "neovim.mode == 'normal' && editorTextFocus"
  },
  {
    "key": "g y",
    "command": "editor.action.goToTypeDefinition",
    "when": "neovim.mode == 'normal' && editorTextFocus"
  },
  {
    "key": "K",
    "command": "editor.action.showHover",
    "when": "neovim.mode == 'normal' && editorTextFocus"
  },
  // ═══════════════════════════════════════════════════════════════
  // GIT (Leader g...)
  // ═══════════════════════════════════════════════════════════════
  {
    "key": "space g g",
    "command": "workbench.view.scm",
    "when": "neovim.mode == 'normal'"
  },
  {
    "key": "space g b",
    "command": "gitlens.toggleFileBlame",
    "when": "neovim.mode == 'normal'"
  },
  {
    "key": "space g d",
    "command": "git.openChange",
    "when": "neovim.mode == 'normal'"
  },
  {
    "key": "space g s",
    "command": "workbench.view.scm",
    "when": "neovim.mode == 'normal'"
  },
  {
    "key": "space g c",
    "command": "gitlens.showQuickRepoHistory",
    "when": "neovim.mode == 'normal'"
  },
  {
    "key": "space g h",
    "command": "gitlens.showQuickFileHistory",
    "when": "neovim.mode == 'normal'"
  },
  {
    "key": "space g l",
    "command": "gitlens.showQuickRepoHistory",
    "when": "neovim.mode == 'normal'"
  },
  {
    "key": "space g t",
    "command": "git.stage",
    "when": "neovim.mode == 'normal'"
  },
  // Hunk navigation
  {
    "key": "] g",
    "command": "workbench.action.editor.nextChange",
    "when": "neovim.mode == 'normal' && editorTextFocus"
  },
  {
    "key": "[ g",
    "command": "workbench.action.editor.previousChange",
    "when": "neovim.mode == 'normal' && editorTextFocus"
  },
  // ═══════════════════════════════════════════════════════════════
  // SEARCH / REPLACE (Leader s...)
  // ═══════════════════════════════════════════════════════════════
  {
    "key": "space s b",
    "command": "actions.find",
    "when": "neovim.mode == 'normal' && editorTextFocus"
  },
  {
    "key": "space s w",
    "command": "workbench.action.findInFiles",
    "when": "neovim.mode == 'normal'"
  },
  // ═══════════════════════════════════════════════════════════════
  // TERMINAL (Leader t...)
  // ═══════════════════════════════════════════════════════════════
  {
    "key": "space t f",
    "command": "workbench.action.terminal.toggleTerminal",
    "when": "neovim.mode == 'normal'"
  },
  {
    "key": "space t h",
    "command": "workbench.action.terminal.toggleTerminal",
    "when": "neovim.mode == 'normal'"
  },
  {
    "key": "space t v",
    "command": "workbench.action.terminal.split",
    "when": "neovim.mode == 'normal'"
  },
  {
    "key": "space t n",
    "command": "workbench.action.terminal.new",
    "when": "neovim.mode == 'normal'"
  },
  // ═══════════════════════════════════════════════════════════════
  // DEBUG (Leader d...)
  // ═══════════════════════════════════════════════════════════════
  {
    "key": "space d c",
    "command": "workbench.action.debug.continue",
    "when": "neovim.mode == 'normal'"
  },
  {
    "key": "space d b",
    "command": "editor.debug.action.toggleBreakpoint",
    "when": "neovim.mode == 'normal' && editorTextFocus"
  },
  {
    "key": "space d s",
    "command": "workbench.action.debug.start",
    "when": "neovim.mode == 'normal'"
  },
  {
    "key": "space d S",
    "command": "workbench.action.debug.stop",
    "when": "neovim.mode == 'normal'"
  },
  {
    "key": "space d i",
    "command": "workbench.action.debug.stepInto",
    "when": "neovim.mode == 'normal'"
  },
  {
    "key": "space d o",
    "command": "workbench.action.debug.stepOut",
    "when": "neovim.mode == 'normal'"
  },
  {
    "key": "space d O",
    "command": "workbench.action.debug.stepOver",
    "when": "neovim.mode == 'normal'"
  },
  // ═══════════════════════════════════════════════════════════════
  // PACKAGE / WORKSPACE (Leader p... / Leader w...)
  // ═══════════════════════════════════════════════════════════════
  {
    "key": "space p",
    "command": "workbench.action.showCommands",
    "when": "neovim.mode == 'normal'"
  },
  {
    "key": "space w",
    "command": "workbench.action.files.save",
    "when": "neovim.mode == 'normal'"
  },
  {
    "key": "space q",
    "command": "workbench.action.closeWindow",
    "when": "neovim.mode == 'normal'"
  },
  {
    "key": "space n",
    "command": "workbench.action.files.newUntitledFile",
    "when": "neovim.mode == 'normal'"
  },
  // ═══════════════════════════════════════════════════════════════
  // SPLIT / WINDOW NAVIGATION (matches your <M-H/J/K/L> custom binds)
  // Using Alt+Shift+H/J/K/L since vscode-neovim handles these natively
  // ═══════════════════════════════════════════════════════════════
  {
    "key": "alt+shift+h",
    "command": "workbench.action.focusLeftGroup",
    "when": "neovim.mode == 'normal' && editorTextFocus"
  },
  {
    "key": "alt+shift+j",
    "command": "workbench.action.focusBelowGroup",
    "when": "neovim.mode == 'normal' && editorTextFocus"
  },
  {
    "key": "alt+shift+k",
    "command": "workbench.action.focusAboveGroup",
    "when": "neovim.mode == 'normal' && editorTextFocus"
  },
  {
    "key": "alt+shift+l",
    "command": "workbench.action.focusRightGroup",
    "when": "neovim.mode == 'normal' && editorTextFocus"
  },
  // ═══════════════════════════════════════════════════════════════
  // YOUR CUSTOM MAPPINGS FROM astrocore.lua
  // ═══════════════════════════════════════════════════════════════
  // <Leader>RR - Reload (no VS Code equivalent - use Reload Window)
  {
    "key": "space R R",
    "command": "workbench.action.reloadWindow",
    "when": "neovim.mode == 'normal'"
  },
  // <Leader>sr - Search and replace (already opens Find/Replace via VS Code)
  {
    "key": "space s r",
    "command": "editor.action.startFindReplaceAction",
    "when": "neovim.mode == 'normal' && editorTextFocus"
  },
  // ═══════════════════════════════════════════════════════════════
  // ESCAPE - jj already handled by vscode-neovim.compositeKeys in settings
  // ═══════════════════════════════════════════════════════════════
  // ═══════════════════════════════════════════════════════════════
  // QUICK SAVE / CLOSE (vim-native, but ensure they pass through)
  // ═══════════════════════════════════════════════════════════════
  {
    "key": "ctrl+s",
    "command": "workbench.action.files.save",
    "when": "editorTextFocus"
  },
  // ═══════════════════════════════════════════════════════════════
  // ZEN MODE (Leader z)
  // ═══════════════════════════════════════════════════════════════
  {
    "key": "space z",
    "command": "workbench.action.toggleZenMode",
    "when": "neovim.mode == 'normal'"
  },
  // ═══════════════════════════════════════════════════════════════
  // PROBLEMS / DIAGNOSTICS (]d and [d for next/prev diagnostic)
  // ═══════════════════════════════════════════════════════════════
  {
    "key": "] d",
    "command": "editor.action.marker.next",
    "when": "neovim.mode == 'normal' && editorTextFocus"
  },
  {
    "key": "[ d",
    "command": "editor.action.marker.prev",
    "when": "neovim.mode == 'normal' && editorTextFocus"
  },
  {
    "key": "space x",
    "command": "workbench.actions.view.problems",
    "when": "neovim.mode == 'normal'"
  }
]
