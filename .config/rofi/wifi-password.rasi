/* Import base theme */
@import "~/.config/rofi/style.rasi"

/* Override positioning for password dialog */
window {
    location: center;
    anchor: center;
    width: 500px;
}

/* Only show input bar for password */
mainbox {
    children: [ inputbar ];
}

/* Style the input bar */
inputbar {
    children: [ prompt, entry ];
}
