{
    "$schema": "https://github.com/fastfetch-cli/fastfetch/raw/dev/doc/json_schema.json",
    "logo": {
        "type": "command-raw",
        "source": "figlet -f banner -w $(tput cols) -c vib1240n",
        "position": "top",
        "padding": {
            "top": 1,
            "bottom": 1,
        },
    },
    "display": {
        "separator": " → ",
    },
    "modules": [
        {
            "type": "os",
            "key": "                    OS",
        },
        {
            "type": "kernel",
            "key": "                Kernel",
        },
        {
            "type": "uptime",
            "key": "                Uptime",
        },
        "break",
        {
            "type": "wm",
            "key": "                    WM",
        },
        {
            "type": "terminal",
            "key": "              Terminal",
        },
        {
            "type": "shell",
            "key": "                 Shell",
        },
        "break",
        {
            "type": "cpu",
            "key": "                   CPU",
        },
        {
            "type": "gpu",
            "key": "                   GPU",
        },
        {
            "type": "memory",
            "key": "                Memory",
        },
        {
            "type": "disk",
            "key": "                  Disk",
        },
        {
            "type": "colors",
            "symbol": "              circle",
        },
    ],
}
