# BACKGROUND
background {
    monitor =
    path = ~/Nextcloud/Wallpaper/Roads/pexels-pixabay-63324.jpg
    blur_passes = 3
    blur_size = 8
    noise = 0.01
    contrast = 0.9
    brightness = 0.8
    vibrancy = 0.2
    vibrancy_darkness = 0.5
}

# GENERAL
general {
    disable_loading_bar = true
    grace = 0
    hide_cursor = false
    no_fade_in = true
    no_fade_out = true
    ignore_empty_input = true
}


# Day
label {
    monitor =
    text = cmd[update:1000] echo -e "$(date +"%A")"
    color = rgba(19, 19, 19, 0.70)
    font_size = 90
    font_family = JetbrainsMono Nerd Font
    position = 0, 350
    halign = center
    valign = center
}

# Date-Month
label {
    monitor =
    text = cmd[update:1000] echo -e "$(date +"%d %B")"
    color = rgba(22, 22, 22, 0.70)
    font_size = 40
    font_family = JetbrainsMono Nerd Font
    position = 0, 250
    halign = center
    valign = center
}

# Time
label {
    monitor =
    text = cmd[update:1000] echo "<span>$(date +"- %I:%M -")</span>"
    color = rgba(0,0,0, 0.70)
    font_size = 120
    font_family = JetbrainsMono Nerd Font
    position = 0, 500
    halign = center
    valign = center
}

# Profie-Photo
image {
    monitor =
    path = $HOME/Pictures/wallpaper/Roads/pexels-pixabay-63324.jpg
    border_size = 0
    border_color = rgba(255, 255, 255, .65)
    size = 260
    rounding = -1
    rotate = 0
    reload_time = -1
    reload_cmd = 
    position = 0, 55
    halign = center
    valign = center
}

# USER-BOX
shape {
    monitor =
    size = 300, 100
    color = rgba(255, 255, 255,0.0)
    rounding = -1
    border_size = 0
    border_color = rgba(255, 255, 255, 0)
    rotate = 0
    xray = false # if true, make a "hole" in the background (rectangle of specified size, no rotation)
    position = 0, -140
    halign = center
    valign = center
}

# USER
label {
    monitor =
    text =  $USER
    color = rgba(216, 222, 233, 0.80)
    font_size = 36
    font_family = JetbrainsMono Nerd Font
    position = 0, -550
    halign = center
    valign = center
}

# INPUT FIELD
input-field {
    monitor =
    size = 300, 60
    outline_thickness = 0
    dots_size = 0.2 # Scale of input-field height, 0.2 - 0.8
    dots_spacing = 0.2 # Scale of dots' absolute size, 0.0 - 1.0
    dots_center = true
    outer_color = rgba(255, 255, 255, 0)
    inner_color = rgba(255, 255, 255, 0.0)
    font_color = rgb(0,0,0)
    fade_on_empty = false
    font_family = JetbrainsMono Nerd Font
    placeholder_text = <i><span foreground="##ffffff99">Enter Pass</span></i>
    hide_input = false
    position = 0, -670
    halign = center
    valign = center
}
shape {
    monitor =
    size = 400, 100
    color = rgba(30,30,30,0.3)
    rounding = -1
    border_size = 0
    border_color = rgba(255, 255, 255, 0)
    rotate = 0
    xray = false # if true, make a "hole" in the background (rectangle of specified size, no rotation)
    position = 1200, -850
    halign = center
    valign = center
}

# Reboot
image {
    monitor =
    path = /home/vib1240n/.config/hypr/gobackward.png
    # color = rgba(0,0,0)
    size = 70
    border_size = 0
    # onclick = reboot now
    position = 1200, -850
    halign = center
    valign = center
}
image {
    monitor =
    path = /home/vib1240n/.config/hypr/moon_zzz_fill.png
    # color = rgba(0,0,0)
    size = 70
    border_size = 0
    # onclick = systemctl suspend
    position = 1300, -850
    halign = center
    valign = center
}
image {
    monitor =
    path = /home/vib1240n/.config/hypr/power.png
    # color = rgba(0,0,0)
    size = 70
    border_size = 0
    # onclick = shutdown now
    position = 1100, -850
    halign = center
    valign = center
}
shape {
    monitor =
    size = 110, 100
    color = rgba(255,0,0,0.0)
    rounding = 0
    border_size = 0
    border_color = rgba(255, 255, 255, 0)
    rotate = 0
    xray = false # if true, make a "hole" in the background (rectangle of specified size, no rotation)
    position = 1200, -850
    halign = center
    valign = center
    onclick = restart now
}
shape {
    monitor =
    size = 150, 100
    color = rgba(0,255,0,0.0)
    rounding = -1
    border_size = 0
    border_color = rgba(255, 255, 255, 0)
    rotate = 0
    xray = false # if true, make a "hole" in the background (rectangle of specified size, no rotation)
    position = 1070, -850
    halign = center
    valign = center
    onclick = shutdown now
}
shape {
    monitor =
    size = 150, 100
    color = rgba(0,0,255,0.0)
    rounding = -1
    border_size = 0
    border_color = rgba(255, 255, 255, 0)
    rotate = 0
    xray = false # if true, make a "hole" in the background (rectangle of specified size, no rotation)
    position = 1320, -850
    halign = center
    valign = center
    onclick = systemctl suspend
}
label {
    monitor =
    # text = cmd[update:5000] bash -c 'bat=$(cat /sys/class/power_supply/BAT*/capacity); if [ $bat -gt 80 ]; then icon=""; elif [ $bat -gt 60 ]; then icon=""; elif [ $bat -gt 40 ]; then icon=""; elif [ $bat -gt 20 ]; then icon=""; else icon=""; fi; echo "$icon $bat%"'
text = cmd[update:5000] bash -c 'bat=$(/bin/cat /sys/class/power_supply/macsmc-battery/capacity); status=$(cat /sys/class/power_supply/BAT*/status); if [ "$status" = "Charging" ]; then icon="󰂄"; elif [ "$bat" -ge 80 ]; then icon="󰂂"; elif [ "$bat" -ge 60 ]; then icon="󰂀"; elif [ "$bat" -ge 40 ]; then icon="󰁾"; elif [ "$bat" -ge 20 ]; then icon="󰁼"; else icon="󰁺"; fi; echo "$icon $bat%"'
    color = rgba(0, 0, 0, 0.80)
    font_size = 42
    font_family = JetbrainsMono Nerd Font
    position = 1300, 850
    halign = center
    valign = center
}

