# ═══════════════════════════════════════════════════════════════════════════════
# HYPRLAND CONFIG - SeaGlass Style
# ═══════════════════════════════════════════════════════════════════════════════

# Source configs
source = ~/.config/hypr/monitors.conf

# ═══════════════════════════════════════════════════════════════════════════════
# MONITOR
# ═══════════════════════════════════════════════════════════════════════════════
monitor=,preferred,auto,auto,vrr,1

# ═══════════════════════════════════════════════════════════════════════════════
# ENVIRONMENT
# ═══════════════════════════════════════════════════════════════════════════════
env = HYPRCURSOR_THEME,Bibata-Modern-Ice
env = HYPRCURSOR_SIZE,32

# ═══════════════════════════════════════════════════════════════════════════════
# AUTOSTART
# ═══════════════════════════════════════════════════════════════════════════════
exec-once = hyprpm reload
exec-once = ulauncher --hide-window &
exec-once = waybar &>/dev/null &
exec-once = wl-paste --type text --watch cliphist store &>/dev/null &
exec-once = wl-paste --type image --watch cliphist store
exec-once = dbus-update-activation-environment --systemd WAYLAND_DISPLAY XDG_CURRENT_DESKTOP
exec-once = ~/.config/hypr/scripts/restore-wallpaper.sh
# ═══════════════════════════════════════════════════════════════════════════════
# VARIABLES
# ═══════════════════════════════════════════════════════════════════════════════
$terminal = kitty
$fileManager = nautilus
$menu = rofi -show drun
$scriptsDir = $HOME/.config/hypr/scripts

# ═══════════════════════════════════════════════════════════════════════════════
# INPUT
# ═══════════════════════════════════════════════════════════════════════════════
input {
    kb_layout = us
    follow_mouse = 1
    touchpad {
        natural_scroll = no
        disable_while_typing = no
    }
    sensitivity = 0
}

# ═══════════════════════════════════════════════════════════════════════════════
# GENERAL
# ═══════════════════════════════════════════════════════════════════════════════
general {
    gaps_in = 5
    gaps_out = 20
    border_size = 2
    col.active_border = rgb(89b4fa) rgb(cba6f7) 45deg
    col.inactive_border = rgb(313244)
    layout = dwindle
    resize_on_border = true
}

# ═══════════════════════════════════════════════════════════════════════════════
# DECORATION
# ═══════════════════════════════════════════════════════════════════════════════
decoration {
    rounding = 10
    blur {
        enabled = true
        size = 8
        passes = 4
        noise = 0.01
        contrast = 0.9
        brightness = 0.8
        vibrancy = 0.2
        vibrancy_darkness = 0.5
        xray = true
        popups = true
    }
    shadow {
        enabled = true
        range = 8
        render_power = 3
        color = rgba(000000D6)
    }
}

# ═══════════════════════════════════════════════════════════════════════════════
# ANIMATIONS
# ═══════════════════════════════════════════════════════════════════════════════
animations {
    enabled = yes
    bezier = myBezier, 0.05, 0.9, 0.1, 1.05
    animation = windows, 1, 7, myBezier
    animation = windowsOut, 1, 7, default, popin 80%
    animation = border, 1, 10, default
    animation = borderangle, 1, 8, default
    animation = fade, 1, 7, default
    animation = workspaces, 1, 6, default
}

# ═══════════════════════════════════════════════════════════════════════════════
# LAYOUT
# ═══════════════════════════════════════════════════════════════════════════════
dwindle {
    pseudotile = yes
    preserve_split = yes
}


# ═══════════════════════════════════════════════════════════════════════════════
# MISC
# ═══════════════════════════════════════════════════════════════════════════════
misc {
    force_default_wallpaper = 0
    disable_hyprland_logo = true
    disable_splash_rendering = true
}

# ═══════════════════════════════════════════════════════════════════════════════
# LAYER RULES
# ═══════════════════════════════════════════════════════════════════════════════
layerrule = blur,waybar
layerrule = blur,rofi
# layerrule = blur,swaync-control-center
# layerrule = blur,swaync-notification-window
layerrule = ignorezero,rofi
layerrule = dimaround,rofi

# ═══════════════════════════════════════════════════════════════════════════════
# WINDOW RULES
# ═══════════════════════════════════════════════════════════════════════════════
windowrulev2 = opacity 0.75 0.75, class:.*
windowrulev2 = float, class:^$,title:^$
windowrulev2 = float, class:pavucontrol
windowrulev2 = float, class:nm-connection-editor
windowrulev2 = float, title:^(Open File)$
windowrulev2 = float, title:^(Save As)$
windowrulev2 = float, title:^(Picture-in-Picture)$

# ═══════════════════════════════════════════════════════════════════════════════
# KEYBINDS
# ═══════════════════════════════════════════════════════════════════════════════
source = ~/.config/hypr/keybinds.conf

# ═══════════════════════════════════════════════════════════════════════════════
env = __GLX_VENDOR_LIBRARY_NAME,mesa

# ═══════════════════════════════════════════════════════════════════════════════
# ASAHI GPU FIX
# ═══════════════════════════════════════════════════════════════════════════════
env = LIBGL_ALWAYS_SOFTWARE,0
env = __GLX_VENDOR_LIBRARY_NAME,mesa



# Clipse floating window
windowrulev2 = float, class:(clipse)
windowrulev2 = size 900 700, class:(clipse)
windowrulev2 = center, class:(clipse)
windowrulev2 = opacity 0.35, class:(clipse)
exec-once = hypridle &>/dev/null &

# Trackpad settings - disable tap-to-click
input {
    touchpad {
        natural_scroll = true
        tap-to-click = false
        drag_lock = false
        disable_while_typing = true
    }
}
# layerrule = blur,swaync-notification-window
exec-once = swaync &>/dev/null &

# ═══════════════════════════════════════════════════════════════════════════════
# WORKSPACE WINDOW RULES - TAG SYSTEM
# ═══════════════════════════════════════════════════════════════════════════════

# Define tags for app categories
windowrule = tag +terminal, class:^(kitty|Alacritty|WezTerm|foot)$
windowrule = tag +projects, class:^(Code|code-oss|VSCodium|Zed|dev.zed.Zed|neovide)$
windowrule = tag +browser, class:^([Ff]irefox|zen-alpha|zen|app.zen_browser.zen|[Gg]oogle-chrome|[Cc]hromium|[Bb]rave-browser)$
windowrule = tag +im, class:^([Dd]iscord|[Ww]ebCord|[Vv]esktop|[Ss]lack|teams-for-linux|telegram-desktop|Signal)$

# Assign tagged apps to workspaces
windowrule = workspace 1 silent, tag:terminal*
windowrule = workspace 1 silent, tag:projects*
windowrule = workspace 2 silent, tag:browser*
windowrule = workspace 3 silent, tag:im*

# Clock hover detection

# ═══════════════════════════════════════════════════════════════════════════════
# EWW POPUP BLUR (GLASSMORPHIC EFFECT)
# ═══════════════════════════════════════════════════════════════════════════════
layerrule = blur, ^(eww).*
layerrule = ignorealpha 0.7, ^(eww).*

