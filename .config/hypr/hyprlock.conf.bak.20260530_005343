# ============================================================================
# hyprlock.conf - SilentSDDM-matching theme
# Cleaned for hyprlock v0.9.2:
#   - Removed: disable_loading_bar (the loading bar itself was removed)
#   - Removed: grace (no longer a general option)
#   - Removed: no_fade_in / no_fade_out (use animations { enabled = false })
#   - Removed: fail_transition from input-field (use animations system)
# ============================================================================
source = ~/.config/hypr/hyprlock-colors.conf
general {
    hide_cursor = true
    immediate_render = true
}

# Disable fade animations entirely if you want instant lock/unlock.
# Comment out the whole block to use defaults (fades enabled).
animations {
    enabled = false
}

# ----------------------------------------------------------------------------
# Background
# NOTE: Original path had parentheses: ~/Pictures/wallpapers/Space(Landscape)/...
# Parens in paths can cause hyprlock to fail to load. Either rename the folder
# (recommended), or escape with backslashes. Update this path to match your
# actual on-disk location.
# ----------------------------------------------------------------------------
background {
    monitor =
    path = ~/Pictures/wallpapers/Space-Landscape/amir-zand-detach-copy.jpg
    blur_passes = 0
    blur_size = 0
    brightness = 1.0
    contrast = 1.0
    vibrancy = 1.0
}

# ----------------------------------------------------------------------------
# User avatar - circular with peach/salmon border
# ----------------------------------------------------------------------------
image {
    monitor =
    path = /var/lib/AccountsService/icons/vib1240n
    size = 120
    rounding = -1
    border_size = 5
    border_color = rgba(232, 162, 142, 1.0)

    position = 0, 100
    halign = center
    valign = center
}

# ----------------------------------------------------------------------------
# Username
# ----------------------------------------------------------------------------
label {
    monitor =
    text = $USER
    color = rgba(255, 255, 255, 1.0)
    font_size = 24
    font_family = JetBrainsMono Nerd Font

    position = 0, 0
    halign = center
    valign = center
}

# ----------------------------------------------------------------------------
# Lock icon (left of password field)
# ----------------------------------------------------------------------------
label {
    monitor =
    text =  
    color = rgba(255, 255, 255, 0.7)
    font_size = 14
    font_family = JetBrainsMono Nerd Font

    position = -100, -60
    halign = center
    valign = center
}

# ----------------------------------------------------------------------------
# Password input field
# ----------------------------------------------------------------------------
input-field {
    monitor =
    size = 320, 45
    outline_thickness = 0
    dots_size = 0.25
    dots_spacing = 0.2
    dots_center = false
    dots_rounding = -1
    outer_color = rgba(0, 0, 0, 0)
    inner_color = rgba(30, 30, 30, 0.85)
    font_color = rgba(255, 255, 255, 0.7)
    font_family = JetBrainsMono Nerd Font
    fade_on_empty = false
    fade_timeout = 1000
    placeholder_text = <i>    Password</i>
    hide_input = false
    rounding = 20
    check_color = rgba(232, 162, 142, 1.0)
    fail_color = rgba(255, 100, 100, 1.0)
    fail_text = <i>$FAIL</i>
    capslock_color = rgba(255, 200, 100, 1.0)
    numlock_color = -1
    bothlock_color = -1
    invert_numlock = false
    swap_font_color = false

    position = 0, -60
    halign = center
    valign = center
}

# ----------------------------------------------------------------------------
# Arrow icon (right of password field)
# ----------------------------------------------------------------------------
label {
    monitor =
    text = 
    color = rgba(255, 255, 255, 0.7)
    font_size = 14
    font_family = JetBrainsMono Nerd Font

    position = 100, -60
    halign = center
    valign = center
}
