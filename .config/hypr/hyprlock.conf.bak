# Hyprlock Configuration
general {
    disable_loading_bar = true
    grace = 0
    hide_cursor = true
    no_fade_in = true
    no_fade_out = true
    ignore_empty_input = true
}

background {
    monitor =
    path = screenshot
    blur_passes = 3
    blur_size = 8
    noise = 0.01
    contrast = 0.9
    brightness = 0.8
    vibrancy = 0.2
    vibrancy_darkness = 0.5
}

input-field {
    monitor =
    size = 800, 80
    outline_thickness = 1
    dots_size = 0.3
    dots_spacing = 0.35
    dots_center = true
    outer_color = rgba(255, 255, 255, 0.1)
    inner_color = rgba(30, 30, 30, 0.8)
    font_color = rgb(240, 240, 240)
    fade_on_empty = false
    placeholder_text = <span foreground="##e0e0e0">Enter Password</span>
    hide_input = false
    position = 0, -150
    halign = center
    valign = center
    check_color = rgba(120, 180, 255, 0.5)
    fail_color = rgba(255, 100, 100, 0.5)
    fail_text = <span foreground="##ff6b6b">Authentication Failed</span>
    capslock_color = rgba(255, 200, 100, 0.5)
}

label {
    monitor =
    text = cmd[update:1000] echo "$(date +'%H:%M')"
    color = rgba(240, 240, 240, 1.0)
    font_size = 90
    font_family = JetBrainsMono Nerd Font
    position = 0, 700
    halign = center
    valign = center
}

label {
    monitor =
    text = cmd[update:1000] echo "$(date +'%A, %B %d')"
    color = rgba(200, 200, 200, 1.0)
    font_size = 24
    font_family = JetBrainsMono Nerd Font
    position = 0, 610
    halign = center
    valign = center
}

label {
    monitor =
    text = $USER
    color = rgba(180, 180, 180, 1.0)
    font_size = 110
    font_family = JetBrainsMono Nerd Font
    position = 0, 0
    halign = center
    valign = center
}
