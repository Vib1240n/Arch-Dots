{
  "$schema": "/etc/xdg/swaync/configSchema.json",
  "positionX": "center",
  "positionY": "top",
  "control-center-width": 400,
  "control-center-height": 600,
  "control-center-margin-top": 45,
  "notification-window-width": 400,
  "fit-to-screen": false,
  "timeout": 5,
  "timeout-low": 3,
  "timeout-critical": 0,
  "transition-time": 200,
  "hide-on-clear": false,
  "hide-on-action": true,
  "script-fail-notify": true,

  "widgets": [
    "title",
    "buttons-grid",
    "mpris",
    "volume",
    "backlight",
    "dnd",
    "notifications"
  ],

  "widget-config": {
    "title": {
      "text": "Control Center",
      "clear-all-button": true,
      "button-text": "󰎟"
    },
    "mpris": {
      "image-size": 96,
      "image-radius": 12
    },
    "volume": {
      "label": "󰕾"
    },
    "backlight": {
      "label": "󰃠"
    },
    "buttons-grid": {
      "actions": [
        {
          "label": "󰖩",
          "command": "nm-connection-editor"
        },
        {
          "label": "󰂯",
          "command": "blueman-manager"
        },
        {
          "label": "󰐥",
          "command": "wlogout"
        },
        {
          "label": "󰕾",
          "command": "pavucontrol"
        }
      ]
    }
  }
}
