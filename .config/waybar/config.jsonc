{
  "layer": "top",
  "position": "top",
  "height": 54,
  "spacing": 0,
  "margin-top": 6,
  "margin-left": 10,
  "margin-right": 10,
  "modules-left": [
    "tray",
    "custom/mode",
    "custom/spotify",
    "custom/caffeinate"
  ],
  "modules-center": [
    "hyprland/workspaces"
  ],
  "modules-right": [
    "pulseaudio",
    "network",
    "battery",
    "custom/control",
    "clock"
  ],
  "hyprland/workspaces": {
    "format": "{id}",
    "on-scroll-up": "hyprctl dispatch workspace e+1",
    "on-scroll-down": "hyprctl dispatch workspace e-1",
    "all-outputs": true,
    "active-only": false
  },
  "custom/mode": {
    "format": " {}",
    "max-length": 40,
    "interval": 5,
    "exec": "cat /tmp/hypr_mode 2>/dev/null || echo ''",
    "tooltip": false
  },
  "clock": {
    "format": "{:%I:%M %p  |  %A, %B %d}",
    "tooltip": false,
    "on-click": "rw toggle notifications"
  },
  "custom/spotify": {
    "exec": "~/.config/waybar/scripts/spotify.sh",
    "return-type": "json",
    "interval": 5,
    "format": "{}",
    "escape": true
  },
  "custom/caffeinate": {
    "format": "{}",
    "exec": "if [ -f /tmp/caffeinate.pid ]; then echo '󰅶'; else echo '󰛊'; fi",
    "interval": 2,
    "on-click": "~/Development/bash_scripts/toggle-caffeinate.sh",
    "tooltip": false
  },
  "pulseaudio": {
    "format": "{icon}",
    "format-muted": "󰖁",
    "format-icons": {
      "default": ["󰕿", "󰖀", "󰕾"]
    },
    "on-click": "rw toggle volume",
    "on-scroll-up": "wpctl set-volume @DEFAULT_AUDIO_SINK@ 5%+",
    "on-scroll-down": "wpctl set-volume @DEFAULT_AUDIO_SINK@ 5%-",
    "tooltip": false
  },
  "network": {
    "format-wifi": "󰤨",
    "format-ethernet": "󰈀",
    "format-disconnected": "󰤭",
    "on-click": "rw toggle stats",
    "tooltip": false
  },
  "battery": {
    "bat": "BAT1",
    "interval": 10,
    "states": {
      "warning": 30,
      "critical": 15
    },
    "format": "{icon}",
    "format-charging": "󰂄",
    "format-plugged": "󰚥",
    "format-icons": ["󰂎", "󰁺", "󰁻", "󰁼", "󰁽", "󰁾", "󰁿", "󰂀", "󰂁", "󰂂", "󰁹"],
    "on-click": "rw toggle stats",
    "tooltip": false
  },
  "custom/control": {
    "format": "󰒓",
    "on-click": "rw toggle control",
    "tooltip": false
  },
  "tray": {
    "spacing": 8,
    "icon-size": 16
  }
}
