/* Notifications - Glass with coral/pink accent (matches tray style) */
#custom-notifications {
  background-color: alpha(@color12, 0.3);
  border: 2px solid alpha(@color12, 0.85);
  color: @color15;
  padding: 0px 10px;
  margin: 4px 0px 4px 5px;
  border-radius: 40px;
  font-size: 16px;
  box-shadow:
    0 2px 8px rgba(0, 0, 0, 0.4),
    0 1px 0 rgba(227, 131, 124, 0.25);
  transition: all 0.3s ease;
}

#custom-notifications.active {
  color: @color12;
  background-color: alpha(@color12, 0.45);
  box-shadow:
    0 0 12px alpha(@color12, 0.7),
    0 2px 8px rgba(0, 0, 0, 0.4),
    0 1px 0 rgba(227, 131, 124, 0.3);
}

#custom-notifications:hover {
  background-color: alpha(@color12, 0.5);
  box-shadow:
    0 0 15px alpha(@color12, 0.8),
    0 2px 10px rgba(0, 0, 0, 0.4);
}
