{
  "layer": "top",
  "position": "top",
  "height": 45,
  "spacing": 5,
  "margin-top": 2,
  "margin-left": 5,
  "margin-right": 5,
  "border-radius": 5,
  "modules-left": [
    "hyprland/window",
    "hyprland/workspaces",
    "custom/mode",
    "tray",
  ],
  "modules-center": [
    "clock"
  ],
  "modules-right": [
    "cpu",
    "memory",
    "disk",
    "network#speed",
    "pulseaudio",
    "network",
    "battery",
  ],
  "hyprland/window": {
    "format": "",
    "icon": true,
    "icon-size": 30,
    "separate-outputs": false,
  },
  "hyprland/workspaces": {
    "format": "{id}",
    "on-scroll-up": "hyprctl dispatch workspace e+1",
    "on-scroll-down": "hyprctl dispatch workspace e-1",
    "all-outputs": true,
    "active-only": false,
  },
  "custom/mode": {
    "format": "{}",
    "max-length": 40,
    "interval": 1,
    "exec": "cat /tmp/hypr_mode 2>/dev/null || echo ''",
    "tooltip": false,
  },
  "clock": {
    "format": "{:%I:%M %p}",
    "format-alt": "{:%A, %B %d, %Y - %I:%M %p}",
    "tooltip-format": "<tt><small>{calendar}</small></tt>",
    "on-click": "swaync-client -t",
  },
  "cpu": {
    "interval": 2,
    "format": "󰻠 {usage}%",
    "tooltip-format": "CPU: {usage}%\nLoad: {load}",
    "on-click": "kitty -e btop",
  },
  "memory": {
    "interval": 2,
    "format": "󰍛 {percentage}%",
    "tooltip-format": "RAM: {used:0.1f}G / {total:0.1f}G ({percentage}%)",
    "on-click": "kitty -e btop",
  },
  "disk": {
    "interval": 30,
    "format": "󰋊 {percentage_used}%",
    "path": "/",
    "tooltip-format": "Disk: {used} / {total} ({percentage_used}%)\nFree: {free}",
    "on-click": "kitty -e df -h",
  },
  "network#speed": {
    "interval": 1,
    "format": "󰓅 {bandwidthDownBits} 󰓢 {bandwidthUpBits}",
    "tooltip-format": "Down: {bandwidthDownBytes}\nUp: {bandwidthUpBytes}",
  },
  "battery": {
    "states": {
      "warning": 30,
      "critical": 15,
    },
    "format": "{icon} {capacity}%",
    "format-icons": [
      "󰂎",
      "󰁺",
      "󰁻",
      "󰁼",
      "󰁽",
      "󰁾",
      "󰁿",
      "󰂀",
      "󰂁",
      "󰂂",
      "󰁹"
    ],
  },
  "network": {
    "format": "{ifname}",
    "format-wifi": "󰖩",
    "format-ethernet": "󰈀",
    "format-disconnected": "󰖪",
    "tooltip-format-wifi": "{essid} ({signalStrength}%)\n{ipaddr}/{cidr}",
    "tooltip-format-ethernet": "{ifname}\n{ipaddr}/{cidr}",
    "on-click": "~/.config/eww/scripts/toggle-wifi-menu.sh",
  },
  "pulseaudio": {
    "format": "{icon} {volume}%",
    "format-muted": "󰖁 {volume}%",
    "format-icons": {
      "default": [
        "󰕿",
        "󰖀",
        "󰕾"
      ],
    },
    "on-click": "~/.config/rofi/scripts/wp-audio.py",
    "on-click-right": "pavucontrol",
  },
  "tray": {
    "spacing": 10,
    "icon-size": 16,
  },
}
