alias dev="cd $HOME/Development"
alias c="clear"
alias restart="exec $SHELL -l"
alias sr="source ~/.zshrc"
alias ppl="ppl.py"
alias ls="lsd -l"
alias csr='clear && sr'
alias ai='claude'
alias vidconvert="source ~/Development/Bash\ Scriptss/vidconvert.sh"
alias haos="ssh -i ~/.ssh/id_rsa root@192.168.5.38 -p 22"
alias config='cd ~/.config'
alias zshrc='nvim ~/.zshrc'
alias nvimrc='nvim "$CONFIG/nvim"'
alias python=python3
alias as3='aws s3 sync'
alias ap3='aws s3 cp'
alias als3='aws s3 ls'
alias proxmox='ssh -i ~/.ssh/id_rsa root@192.168.6.33 -p 22'
alias pihole='ssh -i ~/.ssh/id_rsa root@192.168.6.58 -p 22'
alias udmpro='ssh root@192.168.0.1 -p 22'
alias immich='ssh -i ~/.ssh/id_rsa vib1240n@192.168.6.11 -p 22'
alias bitwarden='ssh -i ~/.ssh/id_rsa root@192.168.6.79 -p 22'
alias aibot='ssh -i ~/.ssh/id_rsa ubuntu@192.168.6.88 -p 22'
alias truenas='ssh -i ~/.ssh/id_rsa truenas_admin@192.168.6.107 -p 22'
